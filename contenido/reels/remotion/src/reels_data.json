        "gap": 24,
        "padding": "80px 0",
        "elements": [
          { "type": "text", "text": "Ese dolor no es señal de que algo está mal.", "delay": 0, "font": "inter", "size": 32, "color": "muted" },
          { "type": "text", "text": "Es señal de que por primera vez", "delay": 20, "font": "inter", "size": 32, "color": "muted" },
          { "type": "text", "text": "estás mirando de verdad.", "delay": 35, "font": "inter", "size": 32, "bold": true },
          { "type": "line", "delay": 70 },
          { "type": "text", "text": "No te hace feliz.", "delay": 90, "font": "playfair", "size": 56, "weight": 700 },
          { "type": "text", "text": "Te hace libre.", "delay": 115, "font": "playfair", "size": 64, "italic": true, "color": "gold" },
          { "type": "text", "text": "Hay una diferencia enorme.", "delay": 145, "font": "inter", "size": 24, "color": "muted" },
          { "type": "text", "text": "🔖 Guarda esto — lo vas a necesitar", "delay": 170, "font": "inter", "size": 26, "color": "gold", "border": true }
        ]
      }
    ]
  },
  {
    "id": "R2",
    "title": "El Complaciente",
    "duration": 25,
    "scenes": [
      {
        "from": 0,
        "duration": 7,
        "gap": 24,
        "padding": "100px 0",
        "elements": [
          { "type": "text", "text": "\"¿Alguna vez dijiste 'sí'", "delay": 0, "font": "playfair", "size": 60, "italic": true },
          { "type": "text", "text": "cuando querías decir 'no'?\"", "delay": 20, "font": "playfair", "size": 60, "italic": true },
          { "type": "line", "delay": 50 },
          { "type": "text", "text": "Eso tiene un nombre.", "delay": 70, "font": "playfair", "size": 52, "weight": 700, "color": "gold" }
        ]
      },
      {
        "from": 7,
        "duration": 11,
        "gap": 28,
        "padding": "100px 0",
        "elements": [
          { "type": "text", "text": "La Máscara", "delay": 0, "font": "playfair", "size": 60, "weight": 700 },
          { "type": "text", "text": "del Complaciente.", "delay": 15, "font": "playfair", "size": 52, "weight": 700, "color": "gold" },
          { "type": "line", "delay": 45 },
          { "type": "text", "text": "No la elegiste conscientemente.", "delay": 65, "font": "inter", "size": 30 },
          { "type": "text", "text": "La construiste para que alguien", "delay": 82, "font": "inter", "size": 30 },
          { "type": "text", "text": "importante te amara.", "delay": 96, "font": "inter", "size": 30, "bold": true },
          { "type": "text", "text": "Tal vez a los 6 años.", "delay": 120, "font": "inter", "size": 26, "color": "muted" },
          { "type": "text", "text": "Tal vez a los 12.", "delay": 136, "font": "inter", "size": 26, "color": "muted" }
        ]
      },
      {
        "from": 18,
        "duration": 7,
        "gap": 30,
        "padding": "100px 0",
        "elements": [
          { "type": "text", "text": "Tu sistema nervioso cree que", "delay": 0, "font": "inter", "size": 30, "color": "muted" },
          { "type": "text", "text": "decir \"no\" es peligroso.", "delay": 18, "font": "inter", "size": 30, "bold": true },
          { "type": "line", "delay": 50 },
          { "type": "text", "text": "No eres demasiado bueno.", "delay": 70, "font": "playfair", "size": 44, "weight": 700 },
          { "type": "text", "text": "Estás en piloto automático.", "delay": 90, "font": "playfair", "size": 44, "weight": 700, "color": "gold" },
          { "type": "text", "text": "Comenta MASCARA → test gratuito", "delay": 130, "font": "inter", "size": 26, "color": "gold", "border": true }
        ]
      }
    ]
  },
  {
    "id": "R3",
    "title": "Historia Personal",
    "duration": 50,
    "scenes": [
      {
        "from": 0,
        "duration": 4,
        "padding": "120px 0",
        "elements": [
          { "type": "text", "text": "\"Hay algo que nunca te he contado", "delay": 10, "font": "playfair", "size": 52, "italic": true },
          { "type": "text", "text": "sobre por qué escribí este libro.\"", "delay": 30, "font": "playfair", "size": 52, "italic": true }
        ]
      },
      {
        "from": 4,
        "duration": 9,
        "gap": 20,
        "padding": "100px 0",
        "elements": [
          { "type": "text", "text": "Hubo un período de mi vida", "delay": 0, "font": "inter", "size": 28 },
          { "type": "text", "text": "en que no me reconocía.", "delay": 18, "font": "inter", "size": 28, "color": "gold" },
          { "type": "line", "delay": 50 },
          { "type": "text", "text": "Era terapeuta.", "delay": 70, "font": "inter", "size": 28 },
          { "type": "text", "text": "Acompañaba a otros a encontrarse.", "delay": 85, "font": "inter", "size": 28 },
          { "type": "line", "delay": 115 },
          { "type": "text", "text": "Y yo mismo", "delay": 135, "font": "inter", "size": 28 },
          { "type": "text", "text": "estaba completamente perdido.", "delay": 150, "font": "inter", "size": 28, "bold": true }
        ]
      },
      {
        "from": 13,
        "duration": 11,
        "gap": 22,
        "padding": "100px 0",
        "elements": [
          { "type": "text", "text": "No era una crisis visible.", "delay": 0, "font": "inter", "size": 28, "color": "muted" },
          { "type": "text", "text": "Fue algo más silencioso.", "delay": 18, "font": "inter", "size": 28, "color": "muted" },
          { "type": "line", "delay": 50 },
          { "type": "text", "text": "Me di cuenta de que", "delay": 70, "font": "inter", "size": 28 },
          { "type": "text", "text": "la persona que los demás veían...", "delay": 85, "font": "inter", "size": 28 },
          { "type": "text", "text": "no era yo.", "delay": 110, "font": "playfair", "size": 56, "weight": 700, "color": "gold" }
        ]
      },
      {
        "from": 24,
        "duration": 11,
        "gap": 28,
        "padding": "100px 0",
        "elements": [
          { "type": "text", "text": "Era una construcción.", "delay": 0, "font": "inter", "size": 28 },
          { "type": "text", "text": "Brillante, funcional, efectiva.", "delay": 18, "font": "inter", "size": 28, "color": "muted" },
          { "type": "line", "delay": 55 },
          { "type": "text", "text": "Pero no era yo.", "delay": 75, "font": "inter", "size": 28, "bold": true },
          { "type": "text", "text": "Eso me rompió.", "delay": 120, "font": "inter", "size": 28, "color": "muted" },
          { "type": "text", "text": "Y luego me salvó.", "delay": 150, "font": "playfair", "size": 56, "weight": 700, "color": "gold" }
        ]
      },
      {
        "from": 35,
        "duration": 15,
        "gap": 24,
        "padding": "100px 0",
        "elements": [
          { "type": "text", "text": "Endonautica nació de ese momento.", "delay": 0, "font": "inter", "size": 24, "color": "muted" },
          { "type": "line", "delay": 30 },
          { "type": "text", "text": "Porque supe que no era el único", "delay": 55, "font": "inter", "size": 28 },
          { "type": "text", "text": "que vivía dentro de un personaje", "delay": 72, "font": "inter", "size": 28 },
          { "type": "text", "text": "que nunca eligió.", "delay": 88, "font": "inter", "size": 28, "color": "gold" },
          { "type": "line", "delay": 130 },
          { "type": "text", "text": "Si algo de esto te suena...", "delay": 160, "font": "inter", "size": 28 },
          { "type": "text", "text": "este es tu lugar.", "delay": 180, "font": "inter", "size": 28, "bold": true, "color": "gold" }
        ]
      }
    ]
  },
  {
